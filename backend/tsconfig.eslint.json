{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "allowJs": true,
    "checkJs": false
  },
  // `exclude` is inherited, and it wins over `include` — the parent excludes
  // `tests`, so it has to be restated here or the test files stay outside the
  // typed lint project.
  "exclude": ["node_modules", "dist"],
  "include": ["src/**/*.ts", "tests/**/*.ts", "*.ts", "*.js", "*.mjs"]
}
