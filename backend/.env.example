# =============================================================================
# GeoMineX backend — environment template  (PRD §7.1)
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Every variable here is validated by Zod at startup (src/config/env.ts);
# the process refuses to start on invalid configuration.
# =============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001

# Reverse-proxy hops in front of this process (Express `trust proxy`).
# Must match the real chain, or req.ip is wrong and both rate limiting and the
# audit trail attribute every request to a proxy instead of the client.
#   1 = local dev: browser -> Next.js rewrite -> Express
#   2 = typical production: browser -> load balancer -> Next.js rewrite -> Express
# Verify after deploying: log in from two networks and confirm the
# `auth.login_success` audit rows carry different ipAddress values.
TRUST_PROXY_HOPS=1

# ── Database ─────────────────────────────────────────────────────────────────
# Must use a restricted database user, never a root/admin account (PRD §9.10).
MONGODB_URI=mongodb://localhost:27017/geominex

# ── JWT / session credentials ────────────────────────────────────────────────
# The two secrets MUST be different values. Reusing one for both would let an
# access token be replayed as a refresh token (PRD §7.1).
#
# Use exactly 64 hex characters = 32 random bytes = 256 bits:
#   - RFC 7518 §3.2 requires >= 256 bits for HS256, so 32 hex chars (128 bits)
#     is NOT acceptable, however tempting the shorter string looks.
#   - More than 256 bits buys nothing: HS256's security caps there.
#   - 64 bytes is also exactly one SHA-256 block. `jsonwebtoken` uses the
#     secret as a UTF-8 string, so a longer secret is hashed down first —
#     marginally more work, zero extra security.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_char_hex
JWT_REFRESH_SECRET=replace_with_a_DIFFERENT_64_char_hex
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# ── Session token hashing (PRD §9.3 / §11.11) ────────────────────────────────
# HMAC key used to hash opaque refresh tokens and OTP codes before storage.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_HASH_SECRET=replace_with_64_char_hex

# ── Application-level encryption (PRD §9.11) ─────────────────────────────────
# AES-256-GCM key: EXACTLY 64 hex chars (32 bytes). A shorter key silently
# weakens the cipher.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_exactly_64_hex_chars

# ── Web ──────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
# Explicit allowlist only — never '*' with credentials (PRD §9.2).
CORS_ORIGINS=http://localhost:3000

# Deployment topology (PRD §9.14 / §11.9). Decision: same-site via Next
# rewrites, so the refresh cookie is SameSite=Strict and no CSRF token layer
# is required. Set to 'cross-site' ONLY together with a CSRF token layer.
# `cross-site` is REJECTED AT STARTUP until the §9.14 CSRF token layer
# exists: it switches the refresh cookie to SameSite=None, which forfeits
# the only CSRF control this API has. §11.9 is the open decision that
# unblocks it.
DEPLOY_TOPOLOGY=same-site

# ── Auth policy ──────────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
INVITE_TTL_HOURS=72

# ── Email (OTP + invitations) ────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace_me
SMTP_PASS=replace_me
EMAIL_FROM=noreply@example.gov.in

# ── File storage & uploads (PRD §9.4, §11.6) ─────────────────────────────────
# §11.6 (storage provider) is still an open decision. Everything goes through a
# storage abstraction; `local` writes under STORAGE_LOCAL_PATH and is for
# development/single-node only — it is not shared between API instances.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./var/uploads
# Cap for the multipart upload route ONLY. The 10kb JSON limit stays untouched;
# raising that would strip body-size protection from every JSON route (§9.2).
MAX_UPLOAD_BYTES=26214400

# ── Extraction / OCR (PRD §11.2, §11.7) ──────────────────────────────────────
# §11.7 is a BLOCKING decision for production: confirm whether external
# providers may process government documents before wiring a real one.
# `local` extracts text OFFLINE — plain text/CSV, and the embedded text layer
# of digital PDFs. No document leaves this machine, so §11.7 does not gate it.
# SCANNED PDFs and images are pixels: they need real OCR, still return zero
# confidence, and are flagged for manual review rather than given invented
# figures.
OCR_PROVIDER=local
OCR_REVIEW_THRESHOLD=0.75

# ── Dashboard metrics (PRD §4.6) ─────────────────────────────────────────────
METRICS_CACHE_TTL_SECONDS=300
# "Time Saved %" assumptions. These are ESTIMATES, not measurements — tune them
# to your own baseline before quoting the figure to anyone.
BASELINE_MANUAL_MINUTES_PER_DOC=45
MINUTES_PER_MANUAL_OVERRIDE=3

# ── AI query & retrieval (PRD §4.4, §9.5, §11.2, §11.7) ────────────────────────
# §11.7 is a BLOCKING decision for production: confirm whether external
# providers may process government documents before wiring a real one.
# `local` answers OFFLINE and EXTRACTIVELY from passages this server has
# already authorised — it selects sentences verbatim from source documents and
# never composes a figure. No document leaves this machine, so §11.7 does not
# gate it. Do not add another value until §11.7 is settled; the API key below
# becomes mandatory at that point.
AI_PROVIDER=local

# How wide retrieval casts before ranking, and how much survives into context.
AI_RETRIEVAL_CANDIDATES=40
AI_RETRIEVAL_TOP_K=8
# Relevance diversity and injection blast radius, one knob: one file must not
# fill the context window.
AI_RETRIEVAL_MAX_CHUNKS_PER_DOCUMENT=2
AI_ANSWER_MAX_PASSAGES=5
# Matches the OCR adapter's MAX_CHUNK_CHARS, so truncation is normally a no-op.
AI_MAX_CONTEXT_CHARS_PER_CHUNK=1200
AI_MAX_ANSWER_CHARS=4000
AI_CITATION_QUOTE_CHARS=300
AI_LOCAL_MAX_SENTENCES=3
AI_ANSWER_TIMEOUT_MS=30000

# `exclude` drops a chunk that trips the injection scanner. DO NOT change this
# casually: the local provider is EXTRACTIVE, so a flagged-but-retained chunk
# would have its injected sentence quoted VERBATIM into a parliamentary draft
# — a failure that does not depend on any model having followed the
# instruction. `flag` exists only for an operator investigating a false
# positive; either way the affected passage count is reported on the response.
AI_INJECTION_POLICY=exclude

# ── Query pipeline (blueprint §4a, PRD §9.4, §9.7) ──────────────────────────
# Answering is asynchronous. On exhausting QUERY_MAX_ATTEMPTS a query moves to
# the terminal `dead_lettered` state and needs an operator, rather than
# retrying forever or stalling in `processing` where it is indistinguishable
# from work still in flight.
QUERY_MAX_ATTEMPTS=3
QUERY_STUCK_TIMEOUT_MINUTES=10

# ── Word cloud & topics (PRD §4.3, §5.6) ────────────────────────────────
TOPICS_CACHE_TTL_SECONDS=900
# The single biggest lever on `wordFrequencies` collection growth.
TOPICS_MAX_TERMS_PER_SOURCE=300
TOPICS_CLUSTER_SIMILARITY=0.35
TOPICS_CLUSTER_MAX_TERMS=60
TOPICS_MAX_CLUSTERS=25
# ~3 Indian fiscal years. Bounds the most expensive request a client can make
# — topics must not be the one read path with no range cap.
TOPICS_MAX_RANGE_DAYS=1100

# ── Analytics (PRD §4.6) ────────────────────────────────────────────
# Analytics deliberately reuses the three metric assumptions above rather than
# taking its own, so /dashboard and /analytics cannot report different numbers
# for the same period.
ANALYTICS_CACHE_TTL_SECONDS=900
ANALYTICS_MAX_BUCKETS=24

# ── Monitoring (optional) ────────────────────────────────────────────────────
SENTRY_DSN=

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# =============================================================================
# NOT USED IN THIS PHASE — kept here so the contract is complete (PRD §7.1).
# Uncomment when a hosted provider is adopted, and confirm the §11.3
# data-residency and §11.7 external-processing decisions first. Both the OCR
# and the AI provider run locally today, so nothing below is read.
# =============================================================================
# OCR_PROVIDER_API_KEY=
# OCR_PROVIDER_ENDPOINT=
# AI_PROVIDER_API_KEY=
# AI_PROVIDER_ENDPOINT=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_BUCKET=
# STORAGE_REGION=

# ── Rate limits, per 60-second window (PRD §9.2) ──────────────────────────────
# Defaults ARE the production values; only loosen them deliberately. Auth and
# public limits key on IP; AI and analytics key on the authenticated user.
# RATE_LIMIT_GLOBAL_MAX=100
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_PUBLIC_MAX=20
# RATE_LIMIT_AI_MAX=12
# RATE_LIMIT_ANALYTICS_MAX=30

# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE CLOUD VISION — OPTIONAL, AND CURRENTLY UNUSED.
#
# LEAVE THIS BLANK unless you specifically want Vision. The offline Tesseract
# engine is what runs, and it needs no setup, no account and no card.
#
# Vision requires a Google Cloud BILLING ACCOUNT with a standing autopay mandate
# (~Rs 15,000 at signup) even though the first 1,000 pages a month are free.
# That is why this project does not use it. PRD 11.7 permits external providers
# — the blocker here is commercial, not regulatory — so the adapter is built and
# tested and simply dormant. If a funded deployment ever wants it, filling this
# in is the whole change; no code moves.
#
# What you give up by leaving it blank: Vision reads ruled forms more accurately,
# and a clean page under Vision can clear the review threshold, whereas every
# Tesseract-read figure is always flagged for a human.
#
# VISION DOES NOT ACCEPT API KEYS. Verified against the live API, it answers a
# key with `401 API keys are not supported by this API`. It needs a SERVICE
# ACCOUNT. To set one up:
#
#   1. In Google Cloud console, enable the "Cloud Vision API" on your project
#      (it requires billing to be enabled; there is a free monthly tier).
#   2. IAM & Admin -> Service Accounts -> Create. NO role is required in the
#      normal case: the Vision API authorises on the API being enabled for the
#      project the service account belongs to, not on a per-resource IAM role.
#      If a call comes back PERMISSION_DENIED, grant "Service Usage Consumer"
#      (roles/serviceusage.serviceUsageConsumer) and retry.
#      Do NOT grant "Cloud Vision AI Service Agent" — despite the name, that is
#      a Google-MANAGED service agent role for Google's own services, not a
#      caller role, and granting it to your own account does nothing useful.
#   3. Keys -> Add key -> Create new key -> JSON. Download it.
#   4. Base64 it to ONE line and paste it below:
#        PowerShell : [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json")) > b64.txt
#        Git Bash   : base64 -w0 key.json
#      Avoid `certutil -encode`: it wraps at 64 columns and adds BEGIN/END
#      headers, so its output is not a single pasteable line.
#
# Base64 rather than the raw JSON because the raw form contains newlines inside
# `private_key`, which most .env loaders and every CI secret store mangle. The
# raw JSON is also accepted if your loader handles it.
#
# THIS IS A REAL SECRET: it authenticates as your GCP project. It belongs here,
# in the backend, and must never be given a NEXT_PUBLIC_ prefix.
GOOGLE_VISION_CREDENTIALS=

# Vision's host. Configurable because PRD 11.3 (data residency) is still OPEN
# and is now the binding constraint — permission to send a document to a vendor
# is not permission to send it to any region. If a residency requirement lands,
# point this at the regional endpoint rather than changing code.
GOOGLE_VISION_ENDPOINT=https://vision.googleapis.com
