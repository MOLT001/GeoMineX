{
  "id": "geominex-local",
  "name": "GeoMineX — Local",
  "values": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001",
      "type": "default",
      "enabled": true
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "default",
      "enabled": true
    },
    {
      "key": "adminEmail",
      "value": "mavdivu@gmail.com",
      "type": "default",
      "enabled": true,
      "description": "The seeded admin. Must match the account created by: npm run seed -- --email <this>. Environment values OVERRIDE collection values, so a stale address here makes sign-in return 200 with no code."
    },
    {
      "key": "otpCode",
      "value": "",
      "type": "default",
      "enabled": true
    },
    {
      "key": "userId",
      "value": "",
      "type": "default",
      "enabled": true
    },
    {
      "key": "sessionId",
      "value": "",
      "type": "default",
      "enabled": true
    },
    {
      "key": "subsidiaryId",
      "value": "",
      "type": "default",
      "enabled": true
    },
    {
      "key": "inviteToken",
      "value": "",
      "type": "default",
      "enabled": true
    },
    {
      "key": "documentId",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Set by POST /documents (or by GET /documents when empty)."
    },
    {
      "key": "extractedFieldId",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Set by GET /documents/:id/extracted-fields."
    },
    {
      "key": "templateId",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Set by GET /report-templates and POST /report-templates."
    },
    {
      "key": "reportId",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Set by POST /reports."
    },
    {
      "key": "reportTitle",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Set by POST /reports. The archive confirmation must equal it exactly (§8.3)."
    },
    {
      "key": "queryId",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Set by POST /queries. Poll GET /queries/:id with it — the answer is asynchronous."
    },
    {
      "key": "otherSubsidiaryId",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "A SECOND subsidiary the admin can see but outOfScopeAccessToken's user is the only grantee of. Paste it from POST /subsidiaries."
    },
    {
      "key": "unknownId",
      "value": "000000000000000000000000",
      "type": "default",
      "enabled": true,
      "description": "A well-formed ObjectId that exists nowhere. Half of every 404 pair (§9.1)."
    },
    {
      "key": "cilAccessToken",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Access token for a cil_user granted {{subsidiaryId}}. Demonstrates 403 on admin-only actions against a visible resource."
    },
    {
      "key": "mocAccessToken",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Access token for a moc_official. Read-only across subsidiaries (§2); demonstrates 403 on write gates."
    },
    {
      "key": "outOfScopeAccessToken",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Access token for a non-admin granted ONLY {{otherSubsidiaryId}}. Demonstrates 404-not-403 on real, existing ids."
    },
    {
      "key": "expiredAccessToken",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "A token past its lifetime, or one whose session was revoked. Demonstrates 401 TOKEN_EXPIRED / TOKEN_INVALID."
    }
  ],
  "_postman_variable_scope": "environment"
}
