# GeoMineX frontend environment — PRD §7.1
#
# Copy to `.env.local` (which is gitignored) and adjust. Every variable here is
# validated with Zod in src/lib/env.ts at BUILD time, so a bad value fails the
# build rather than the user's first page load.
#
# ─────────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_ IS A DISCLOSURE BOUNDARY, NOT A NAMING CONVENTION.
#
# Anything carrying the prefix is inlined into the JavaScript bundle at build
# time and is readable by anyone who opens a page. No OCR key, AI key, storage
# credential, JWT secret or database URI may ever carry it (§7.1, §9.10).
#
# That the frontend needs exactly ONE variable is the design working: every
# secret this product holds belongs to the backend, behind the API.
# ─────────────────────────────────────────────────────────────────────────────

# Origin of the Express API. Used ONLY by next.config.ts, on the server, to
# decide where the /api/v1/* rewrite forwards to.
#
# Browser code never calls this origin directly — it calls the relative path
# /api/v1/* on the Next origin, which is what keeps the SameSite=Strict refresh
# cookie attached and lets the CSP hold `connect-src 'self'` (§9.14, §11.9).
NEXT_PUBLIC_API_BASE_URL=http://localhost:5001

# This app's own public origin. Used only to resolve absolute metadata URLs
# (Open Graph image, canonical links). Without it Next falls back to
# http://localhost:3000 and ships link previews pointing at a dev machine.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
