# GeoMineX frontend environment — PRD §7.1
#
# Copy to `.env.local` (which is gitignored) and adjust. Every variable here is
# validated with Zod in src/lib/env.ts at BUILD time, so a bad value fails the
# build rather than the user's first page load.
#
# ─────────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_ IS A DISCLOSURE BOUNDARY, NOT A NAMING CONVENTION.
#
# Anything carrying the prefix is inlined into the JavaScript bundle at build
# time and is readable by anyone who opens a page. No OCR key, AI key, storage
# credential, JWT secret or database URI may ever carry it (§7.1, §9.10).
#
# That the frontend needs exactly ONE variable is the design working: every
# secret this product holds belongs to the backend, behind the API.
# ─────────────────────────────────────────────────────────────────────────────

# Origin of the Express API. Used ONLY by next.config.ts, on the server, to
# decide where the /api/v1/* rewrite forwards to.
#
# Browser code never calls this origin directly — it calls the relative path
# /api/v1/* on the Next origin, which is what keeps the SameSite=Strict refresh
# cookie attached and lets the CSP hold `connect-src 'self'` (§9.14, §11.9).
NEXT_PUBLIC_API_BASE_URL=http://localhost:5001

# This app's own public origin. Used only to resolve absolute metadata URLs
# (Open Graph image, canonical links). Without it Next falls back to
# http://localhost:3000 and ships link previews pointing at a dev machine.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Gemini key for the follow-up assistant on the query screen.
#
# This is an ACKNOWLEDGED exception to the rule above, and the only one. Leave
# it unset and the assistant simply does not appear; nothing else changes.
#
# Because it carries NEXT_PUBLIC_, it is inlined into the JavaScript bundle and
# READABLE BY ANYONE WHO LOADS A PAGE. Use a key you are willing to have public,
# restrict it to the Generative Language API in Google AI Studio, and give it a
# low quota. Do not reuse a key that has any other access.
#
# It exists only while the backend is not deployed. When it is, the assistant
# moves behind the API as a provider adapter and this variable is deleted.
#
# (A VITE_-prefixed name does nothing in Next.js — only NEXT_PUBLIC_ is inlined
# into the browser bundle. This is the equivalent variable.)
#
# Get a free key: https://aistudio.google.com/apikey
NEXT_PUBLIC_GEMINI_API_KEY=

# Optional. Which Gemini model to call; blank uses the pin in
# features/queries/gemini.ts.
#
# ─── THE FREE TIER IS SMALL, AND IT IS PER MODEL PER DAY ─────────────────────
# Measured against a live key: the default model allows 20 requests PER DAY
# (quota `GenerateRequestsPerDayPerProjectPerModel-FreeTier`). The query screen
# spends one automatically per query it shows, plus one per follow-up, so a
# dozen page loads can exhaust it. When that happens the panel says so and names
# the allowance rather than claiming a transient rate limit.
#
# The budget is per MODEL, so switching here gives a fresh allowance. Models
# that answered on a live key at the time of writing: gemini-3.6-flash (default,
# best on comparison questions), gemini-3.5-flash, gemini-3.7-flash,
# gemini-3.5-flash-lite, gemini-3.1-flash-lite. The lite models are faster and
# more cautious — they decline to infer an unlabelled table column where the
# flash models will reason about it.
# ─────────────────────────────────────────────────────────────────────────────
#
# Google RETIRES models — the original pin stopped working in production with
# "This model is no longer available". If that happens again, the fix is to set
# a current model here and restart; no code change is needed. List what your key
# can actually use:
#
#   curl -H "x-goog-api-key: $KEY" https://generativelanguage.googleapis.com/v1beta/models
#
# Avoid the floating `gemini-flash-latest` alias: besides changing behaviour
# under you, it is where every unpinned caller lands and it returned 503 "high
# demand" while the pinned models answered normally.
NEXT_PUBLIC_GEMINI_MODEL=
